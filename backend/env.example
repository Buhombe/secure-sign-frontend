# ============================================================
# Secure-Sign — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

NODE_ENV=development

# ── Server ──────────────────────────────────────────────────
PORT=5000
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securesign
DB_USER=milton
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────
# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_BYTES
JWT_ACCESS_EXPIRES=15m
JWT_ISSUER=secure-sign-api
JWT_AUDIENCE=secure-sign-client

# ── JWT Refresh ───────────────────────────────────────────────
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_EXPIRES_MS=604800000

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Rate limits (optional — defaults in security.js) ─────────
# RL_AUTH_WINDOW_MS=900000
# RL_AUTH_MAX=10
# RL_API_WINDOW_MS=60000
# RL_API_MAX=60
# RL_FILES_WINDOW_MS=60000
# RL_FILES_MAX=20

# ── Upload ───────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760

# ── Password policy ──────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12

# ── Account lockout ───────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_BACKOFF_MS=1000
LOCKOUT_DURATION_MS=1800000

# ── MFA ──────────────────────────────────────────────────────
MFA_ISSUER=SecureSign

# ── Field Encryption (Phase 3) ───────────────────────────────
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS