# ============================================================================
# SecureSign — Environment Variables
# Copy to .env and fill in all values before starting the server.
# NEVER commit .env to version control.
# ============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Public base URL used in signing email links (no trailing slash)
BASE_URL=https://app.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securesign
DB_USER=securesign_user
DB_PASSWORD=your_db_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_hex_jwt_secret_here

# ── Field-level Encryption ────────────────────────────────────────────────────
# 64 hex chars = 32 bytes for AES-256-GCM
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=your_64_char_hex_field_encryption_key_here

# ── Audit HMAC ────────────────────────────────────────────────────────────────
# Minimum 32 chars. Protects audit log row integrity.
AUDIT_HMAC_KEY=your_audit_hmac_key_minimum_32_chars_here

# ── Resend (Email) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address — must be from a verified domain in Resend
EMAIL_FROM=SecureSign <noreply@yourdomain.com>

# ── Cloudinary (File Storage) ─────────────────────────────────────────────────
# Found at https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: folder path inside Cloudinary (default: securesign/documents)
CLOUDINARY_FOLDER=securesign/documents

# ── Token Expiry ──────────────────────────────────────────────────────────────
# How many hours a recipient signing token is valid (default: 72)
RECIPIENT_TOKEN_EXPIRY_HOURS=72

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://app.yourdomain.com
